<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="onrobot">

  <!-- One OnRobot gripper fixed to the world, geometry only (for viewing and for checks).
       onrobot_type is required: it is not declared with a default, so xacro stops when it is not given.
       prefix is empty unless given (xacro cannot receive an empty value from the command line). -->
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find onrobot_description)/urdf/onrobot_macro.xacro"/>
  <xacro:onrobot onrobot_type="$(arg onrobot_type)" prefix="$(arg prefix)"/>

  <link name="world"/>
  <joint name="$(arg prefix)onrobot_base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="$(arg prefix)onrobot_base_link"/>
  </joint>

</robot>
