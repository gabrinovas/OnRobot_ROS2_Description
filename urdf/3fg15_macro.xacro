<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find onrobot_description)/urdf/inc/common_utils.xacro" />
  <xacro:include filename="$(find onrobot_description)/urdf/inc/common_materials.xacro" />

  <!-- ============================================= -->
  <!-- Usa joint: finger_width → topic: /finger_width_controller/commands -->
  <!-- ============================================= -->
  <xacro:macro name="onrobot_3fg15" params="prefix onrobot_type:='3fg15'">

    <!-- ====================== Base Link (STL COMPLETO) ====================== -->
    <link name="${prefix}onrobot_base_link">
      <inertial>
        <origin xyz="0 0 0.05" rpy="${-pi/2} 0 0"/>
        <mass value="1.8"/>
        <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.010"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.05" rpy="${-pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/3fg15/visual/3fg15.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="onrobot_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="${-pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/3fg15/collision/3fg15.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- ====================== Mock Link (invisible, solo para joint) ====================== -->
    <link name="${prefix}finger_width_mock_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.001 0.001 0.001"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.001 0.001 0.001"/></geometry>
      </collision>
    </link>

    <!-- ====================== Main Control Joint: finger_width (0 a 150 mm) ====================== -->
    <joint name="${prefix}finger_width" type="prismatic">
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}finger_width_mock_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.150" effort="240" velocity="0.3"/>
      <!-- 150 mm = 0.15 m (diámetro externo del 3FG15) -->
    </joint>

    <!-- ====================== TCP Link (punto de agarre) ====================== -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}gripper_tcp"/>
    </joint>

    <!-- ====================== Transmission (genera /finger_width_controller) ====================== -->
    <xacro:transmission_macro prefix="${prefix}" joint_name="finger_width"/>

  </xacro:macro>
</robot>