<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find onrobot_description)/urdf/inc/common_materials.xacro" />

  <!-- Geometry of the 2FG7. gripper: the content of config/grippers/2fg7.yaml -->
  <xacro:macro name="onrobot_gripper_geometry" params="prefix gripper">
    <xacro:property name="width" value="${gripper['joints']['finger_width']}"/>
    <xacro:property name="fingers" value="${gripper['fingers']}"/>

    <!-- Base Link -->
    <link name="${prefix}onrobot_base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/visual/Quick_Changer_Robot_side_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="onrobot_silver"/>
      </visual>
      <visual>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/visual/official_base_onrobot.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="onrobot_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/collision/Quick_Changer_Robot_side_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/collision/official_base_onrobot.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Finger Links -->
    <link name="${prefix}left_finger_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
      </inertial>
      <visual>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/visual/official_left_finger.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="onrobot_silver"/>
      </visual>
      <collision>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/collision/official_left_finger.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}right_finger_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
      </inertial>
      <visual>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/visual/official_right_finger.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="onrobot_silver"/>
      </visual>
      <collision>
        <origin xyz="-0.05539 -0.14017 -0.28046" rpy="1.570796 0 0"/>
        <geometry>
          <mesh filename="package://onrobot_description/meshes/2fg7/collision/official_right_finger.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Dummy link for the main control joint -->
    <link name="${prefix}finger_width_mock_link">
      <inertial>
        <mass value="1e-9"/>
        <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
      </inertial>
    </link>
    
    <!-- Main control joint (finger_width) -->
    <joint name="${prefix}finger_width" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}finger_width_mock_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="${width['lower']}" upper="${width['upper']}" velocity="${width['velocity']}" effort="${width['effort']}"/>
    </joint>

    <!-- Left Finger Joint -->
    <joint name="${prefix}left_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 3.141593"/>
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}left_finger_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="${fingers['lower']}" upper="${fingers['upper']}" effort="${fingers['effort']}" velocity="${fingers['velocity']}"/>
      <mimic joint="${prefix}finger_width" multiplier="${fingers['mimic_multiplier']}" offset="${fingers['mimic_offset']}"/>
    </joint>

    <!-- Right Finger Joint -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 3.141593"/>
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}right_finger_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${fingers['lower']}" upper="${fingers['upper']}" effort="${fingers['effort']}" velocity="${fingers['velocity']}"/>
      <mimic joint="${prefix}finger_width" multiplier="${fingers['mimic_multiplier']}" offset="${fingers['mimic_offset']}"/>
    </joint>

    <!-- TCP Link -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 ${gripper['tcp_offset']}" rpy="0 0 0"/>
      <parent link="${prefix}onrobot_base_link"/>
      <child link="${prefix}gripper_tcp"/>
    </joint>

  </xacro:macro>
</robot>