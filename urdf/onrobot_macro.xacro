<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Geometry of one OnRobot gripper: links, joints and the gripper_tcp frame, hanging from
       ${prefix}onrobot_base_link. What the gripper is comes from config/grippers/<onrobot_type>.yaml, so a
       new gripper needs that file and its geometry file and no change here.
       The ros2_control hardware of the gripper is described in the onrobot_driver package. -->
  <xacro:macro name="onrobot" params="onrobot_type prefix">
    <xacro:property name="gripper"
      value="${xacro.load_yaml('$(find onrobot_description)/config/grippers/' + onrobot_type + '.yaml')}"/>
    <xacro:include filename="$(find onrobot_description)/${gripper['geometry']}"/>
    <xacro:onrobot_gripper_geometry prefix="${prefix}" gripper="${gripper}"/>
  </xacro:macro>

</robot>
