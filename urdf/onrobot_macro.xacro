<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Main macro for all OnRobot grippers -->
  <xacro:macro name="onrobot"
    params="
      onrobot_type
      prefix:=''
      use_fake_hardware:=false
      use_mock_hardware:=false
      connection_type:=tcp
      device:=/tmp/ttyUR
      ip_address:=192.168.1.1
      port:=502
      device_address:=65
    ">

    <!-- ====================== 2FG7 ====================== -->
    <xacro:if value="${onrobot_type == '2fg7'}">
      <xacro:include filename="$(find onrobot_description)/urdf/2fg7_macro.xacro"/>
      <xacro:onrobot_2fg7 prefix="${prefix}" onrobot_type="${onrobot_type}"/>
    </xacro:if>

    <!-- ====================== 3FG15 ====================== -->
    <xacro:if value="${onrobot_type == '3fg15'}">
      <xacro:include filename="$(find onrobot_description)/urdf/3fg15_macro.xacro"/>
      <xacro:onrobot_3fg15 prefix="${prefix}"/>
    </xacro:if>

    <!-- ====================== VGC10 ====================== -->
    <xacro:if value="${onrobot_type == 'vgc10'}">
      <xacro:include filename="$(find onrobot_description)/urdf/vgc10_macro.xacro"/>
      <xacro:onrobot_vgc10 prefix="${prefix}"/>
    </xacro:if>

    <!-- ====================== ROS2 Control (Humble) ====================== -->
    <xacro:if value="${onrobot_type in ['2fg7', '3fg15']}">
      <ros2_control name="OnRobotGripper" type="actuator">
        <hardware>
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <!-- 2FG7 - TwoFG Hardware Interface -->
            <xacro:if value="${onrobot_type == '2fg7'}">
              <plugin>onrobot_driver::TwoFGHardwareInterface</plugin>
              <param name="onrobot_type">${onrobot_type}</param>
              <param name="prefix">${prefix}</param>
              <param name="connection_type">${connection_type}</param>
              <param name="device">${device}</param>
              <param name="ip_address">${ip_address}</param>
              <param name="port">${port}</param>
              <param name="device_address">${device_address}</param>
              <param name="use_fake_hardware">${use_fake_hardware}</param>
            </xacro:if>

            <!-- 3FG15 - ThreeFG Hardware Interface -->
            <xacro:if value="${onrobot_type == '3fg15'}">
              <plugin>onrobot_driver::ThreeFGHardwareInterface</plugin>
              <param name="onrobot_type">${onrobot_type}</param>
              <param name="prefix">${prefix}</param>
              <param name="connection_type">${connection_type}</param>
              <param name="device">${device}</param>
              <param name="ip_address">${ip_address}</param>
              <param name="port">${port}</param>
              <param name="device_address">${device_address}</param>
              <param name="use_fake_hardware">${use_fake_hardware}</param>
            </xacro:if>
          </xacro:unless>
        </hardware>

        <!-- Joint configuration for actuated grippers -->
        <joint name="${prefix}finger_width">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <state_interface name="grip_detected"/>
          <state_interface name="busy"/>
        </joint>
      </ros2_control>
    </xacro:if>

    <!-- VGC10 Vacuum Gripper -->
    <xacro:if value="${onrobot_type == 'vgc10'}">
      <ros2_control name="OnRobotGripper" type="actuator">
        <hardware>
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <plugin>onrobot_driver::VGC10HardwareInterface</plugin>
            <param name="onrobot_type">${onrobot_type}</param>
            <param name="prefix">${prefix}</param>
            <param name="connection_type">${connection_type}</param>
            <param name="device">${device}</param>
            <param name="ip_address">${ip_address}</param>
            <param name="port">${port}</param>
            <param name="device_address">${device_address}</param>
            <param name="use_fake_hardware">${use_fake_hardware}</param>
          </xacro:unless>
        </hardware>

        <!-- Independent Dual Vacuum Channels -->
        <joint name="${prefix}vacuum_channel_a">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <state_interface name="vacuum_level"/>
          <state_interface name="pressure_kpa"/>
        </joint>
        <joint name="${prefix}vacuum_channel_b">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <state_interface name="vacuum_level"/>
          <state_interface name="pressure_kpa"/>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>
</robot>